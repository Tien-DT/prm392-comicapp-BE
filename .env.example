# Environment variables required for the application

# 1. Database
# The connection string for your PostgreSQL database.
# Example: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DATABASE_URL=""

# 2. Server Port
# The port the server will run on. Defaults to 3000 if not set.
PORT=3000

# 3. API URL
# The base URL for your API. Used for Swagger documentation.
# For local development, leave empty (defaults to http://localhost:PORT).
# For production (e.g., Render), set to your deployed URL.
# Example: "https://your-app.onrender.com"
API_URL=""

# 4. JWT Secret
# A strong, secret key for signing JWT tokens.
# You can generate one using an online generator.
JWT_SECRET=""

# 5. Google OAuth Credentials
# Your Google Client ID for verifying Google Sign-In tokens.
# 
# How to get Google Client ID:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable "Google+ API" in APIs & Services -> Library
# 4. Go to "Credentials" -> "Create Credentials" -> "OAuth 2.0 Client IDs"
# 5. Set Application type to "Web application" (or "iOS"/"Android" for mobile apps)
# 6. For web: Add authorized redirect URIs if needed
# 7. Copy the "Client ID" (format: 123456789-abc123def456.apps.googleusercontent.com)
# 8. If using React Native with Expo, you may also need the iOS/Android client IDs
GOOGLE_CLIENT_ID=""

# 6. Supabase Storage Credentials
# Your Supabase project URL and keys for file uploads (PDF chapters).
# 
# ⚠️ SETUP REQUIRED - Xem hướng dẫn: SUPABASE_PROJECT_SETUP.md
#
# How to setup Supabase:
# 1. Go to https://app.supabase.com
# 2. Create new project (name: prm392-comic-app, region: Singapore)
# 3. Go to Settings -> API
# 4. Copy "Project URL" (format: https://xxxxxxxxxxxxx.supabase.co)
# 5. Copy "service_role" key (NOT anon key)
# 6. Go to Storage -> Create bucket "comic-chapters" with Public = ON
# 7. Add policy: "Public read access" for SELECT operations
# 
# Get these from your Supabase project settings -> API section
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Service Role Key - Has FULL permissions, keep SECRET!
# ⚠️ NEVER commit this to git or expose to client-side code
# ⚠️ Only use on backend server
# Copy from: Supabase Dashboard -> Settings -> API -> service_role key
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY"

# Anon Key - Safe to use on client-side (with Row Level Security enabled)
# Optional for this project - backend uses service_role key
SUPABASE_ANON_KEY=""

# 7. Environment
# Set to "production" in production to hide error details
NODE_ENV=development
